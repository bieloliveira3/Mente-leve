# URL do checkout. Se vazia, os botões usam o link da Cakto definido no código.
NEXT_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/3am8wy3_1137980

# PostHog Cloud: copie o Project token público e o host da região em Settings > Project.
# A documentação atual usa PROJECT_TOKEN (antes chamado Public Project API Key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Debug só funciona em next dev. Sem credenciais, valida localmente sem enviar eventos.
NEXT_PUBLIC_POSTHOG_DEBUG=false
# Só habilite com um projeto PostHog separado para testes; por padrão dev não envia.
NEXT_PUBLIC_POSTHOG_CAPTURE_IN_DEV=false
